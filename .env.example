# ===== copy this file to ".env" and fill it in. NEVER commit .env =====
# Generate each secret in PowerShell:
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))

POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_PASSWORD=

# your public address (needed for the NOWPayments webhook)
PUBLIC_URL=https://yourdomain.com
USD_RWF=1450

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MOMO_PAY_NUMBER=
PEEK_DAILY_BUDGET=5000000

# ---- HOME PC + Cloudflare Tunnel (defaults) ----
SITE_ADDRESS=:80
WEB_BIND=127.0.0.1
WEB_PORT=8080
WEB_TLS_PORT=8443
TUNNEL_TOKEN=

# ---- VPS with its own domain (replace the block above with this) ----
# SITE_ADDRESS=yourdomain.com
# WEB_BIND=0.0.0.0
# WEB_PORT=80
# WEB_TLS_PORT=443
